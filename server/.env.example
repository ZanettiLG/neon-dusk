# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://neondusk:neondusk_dev@localhost:5432/neondusk

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-32-byte-hex-string-here
JWT_REFRESH_SECRET=change-me-generate-a-random-32-byte-hex-string-here

# Admin API — guards /api/admin/* endpoints. Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me-generate-a-random-32-byte-hex-string-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin Panel (ND-052) — auto-seed on startup (optional, idempotent)
# Password must match the login schema: ≥8 chars, 1 uppercase, 1 digit.
ADMIN_EMAIL=admin@neondusk.local
ADMIN_PASSWORD=Change-Me-Admin-123

# Test User — auto-seed on startup (optional, idempotent)
# TEST_USER_EMAIL=test-user@example.com
# TEST_USER_PASSWORD=Change-Me-Test-123
