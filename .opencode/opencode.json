{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "autoupdate": "notify",
  "subagent_depth": 3,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "default_agent": "dev-orchestrator",
  "model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "write": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "ask",
    "skill": "allow",
    "task": "allow",
    "external_directory": {
      ".handoff/": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.secret": "deny"
    }
  },
  "agent": {
    "dev-orchestrator": {
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.2,
      "mode": "all",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  }
}
