# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://neondusk:neondusk_dev@localhost:5432/neondusk

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-32-byte-hex-string-here
JWT_REFRESH_SECRET=change-me-generate-a-random-32-byte-hex-string-here

# Admin API — guards /api/admin/* endpoints (openssl rand -hex 32)
ADMIN_API_KEY=change-me-generate-a-random-32-byte-hex-string-here

# CORS
CORS_ORIGIN=http://localhost:5173
